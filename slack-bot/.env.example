# Slack (api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode app-level token with connections:write (no public URL needed).
SLACK_APP_TOKEN=xapp-...
# Only needed if you run over HTTP instead of Socket Mode (leave SLACK_APP_TOKEN empty then).
# SLACK_SIGNING_SECRET=
# PORT=3000

# GitHub fine-grained token scoped to the repo: Issues (read/write) + Contents (read).
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=169Pi/devrel

# Alpie drafting (optional). Get a key at https://playground.169pi.ai/dashboard/api-keys
# Without it the bot still works, with plain forms and no drafting.
ALPIE_API_KEY=
# ALPIE_MODEL=alpie-32b
# ALPIE_BASE_URL=https://api.169pi.com/v1
# ALPIE_TIMEOUT_SECONDS=90

# Optional
# SLACK_COMMAND=/devrel-issue
# SLACK_NOTIFY_CHANNEL=C0123456789   # announce every new issue in a team channel (invite the bot first)
# GITHUB_TEMPLATE_REF=main           # branch to read templates from (default branch if unset)
# TEMPLATE_CACHE_SECONDS=300
# TEMPLATE_DIR=../.github/ISSUE_TEMPLATE  # read templates from disk instead of GitHub
