# Slack (api.slack.com/apps -> your app)
SLACK_BOT_TOKEN=xoxb-...
# Socket Mode app-level token with connections:write (no public URL needed).
SLACK_APP_TOKEN=xapp-...
# Only needed if you run over HTTP instead of Socket Mode (leave SLACK_APP_TOKEN empty then).
# SLACK_SIGNING_SECRET=
# PORT=3000

# GitHub fine-grained token scoped to the repo: Issues (read/write) + Contents (read).
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=169Pi/devrel

# Alpie drafting (optional). Set ALPIE_BASE_URL and/or ALPIE_API_KEY to turn it on.
# Without either, the bot still works, with plain forms and no drafting.
# Defaults: the hosted Alpie Seed 9B endpoint (no key needed) with reasoning off.
ALPIE_BASE_URL=https://test.169pi.ai/v1
# ALPIE_MODEL=alpie_9b
# ALPIE_API_KEY=                     # only if your endpoint needs one
# ALPIE_THINKING=false               # true turns on reasoning mode: slower, rarely needed for drafting
# ALPIE_TIMEOUT_SECONDS=60

# Optional
# SLACK_COMMAND=/alpieca
# SLACK_NOTIFY_CHANNEL=C0123456789   # also post every new issue card here; use the same channel as the
#                                    # GitHub Action's SLACK_ISSUES_CHANNEL so all issues land in one place
# SLACK_TRIAGE_USERS=U012AB,U034CD    # only these Slack users can use Close/Label/Assign/Comment (default: everyone)
# SLACK_HOME_CHANNELS=C0C507GN03A     # Alpieca answers every message here without an @mention (default: 169Pi's
#                                    # #alpieca channel); set it empty to turn this off
# DATA_DIR=~/.alpieca                 # where Slack -> GitHub username links are remembered
# GITHUB_TEMPLATE_REF=main           # branch to read templates from (default branch if unset)
# TEMPLATE_CACHE_SECONDS=300
# TEMPLATE_DIR=../.github/ISSUE_TEMPLATE  # read templates from disk instead of GitHub

# Product feedback (optional): file feedback into a second, usually private, repo. Its template
# lives in slack-bot/feedback-templates/. See "Product feedback" in the README.
# FEEDBACK_REPO=169Pi/app-alpie
# FEEDBACK_GITHUB_TOKEN=github_pat_...         # Issues read/write on FEEDBACK_REPO only
# FEEDBACK_GITHUB_MENTION=@169Pi/engineering   # who feedback issues notify on GitHub
# FEEDBACK_SLACK_MENTION=S0123456789           # Slack user group to tag on feedback cards
# FEEDBACK_TEMPLATE_DIR=feedback-templates     # read its templates from disk instead (development)
